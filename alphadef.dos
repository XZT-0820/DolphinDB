//1. VOL
def VOL_log_1minret(pricedata, n){
    t = select *, log(Close) as log_close from pricedata where Close > 0 order by SecurityID, TradeDate, MinuteStart
    // 计算对数收益率
    update t set ret = log_close - prev(log_close) context by SecurityID, TradeDate
    // 计算过去n分钟的收益率标准差
    update t set VOL = mstd(ret, n) context by SecurityID, TradeDate

    return (select TradeDate, SecurityID, MinuteStart + 1 AS MinuteStart, 
            "VOL_log_1minret_" + string(n) + "min" as factorname, 
            VOL as value
    from t 
    order by TradeDate,SecurityID,MinuteStart)
}


//2. dVOL
def d_VOL_log_1minret(pricedata, n){
    t = select *, log(Close) as log_close from pricedata where Close > 0 order by SecurityID, TradeDate, MinuteStart
    // 计算对数收益率
    update t set ret = log_close - prev(log_close) context by SecurityID, TradeDate
    // 计算过去n分钟的收益率标准差
    update t set VOL = mstd(ret, n) context by SecurityID, TradeDate
    return (select
               TradeDate,
               SecurityID,
               MinuteStart + 1 AS MinuteStart,
               "d_VOL_log_1minret_" + string(n) + "min" as factorname,
               iif(prev(VOL) == 0.0, NULL, (VOL - prev(VOL)) / prev(VOL)) as value
           from t
           order by TradeDate,SecurityID,MinuteStart)
}

// 3. VWVOL
def VWVOL(pricedata, n){
    t = select *, log(Close) as log_close from pricedata where Close > 0 order by SecurityID, TradeDate, MinuteStart
    t = select *, log_close - prev(log_close) as ret,
    mavg(Volume, n) as VOLM from t 
    context by SecurityID, TradeDate
    order by SecurityID, TradeDate, MinuteStart

    update t set VOL = mstd(ret, n) context by SecurityID, TradeDate

    return (select TradeDate, SecurityID, MinuteStart + 1 AS MinuteStart, 
            "VWVOL_"+string(n) + "min" as factorname, 
            VOL * VOLM as value
    from t 
    order by TradeDate,SecurityID,MinuteStart)
}

// 4. upVOL
def up_VOL_log_1minret(pricedata, n){
    t = select *, log(Close) as log_close from pricedata where Close > 0 order by SecurityID, TradeDate, MinuteStart
    // 计算对数收益率
    update t set ret = log_close - prev(log_close) context by SecurityID, TradeDate
    update t set up_VOL =moving(
        defg(returns){
        mean_return = avg(returns)
        up_rets = max(returns - mean_return, 0)
        return sqrt(sum2(up_rets) / (size(returns) - 1))
    }, ret, n
    ) context by SecurityID, TradeDate
    return (select
               TradeDate,
               SecurityID,
               MinuteStart + 1 AS MinuteStart,
               "up_VOL_log_1minret_" + string(n) + "min" as factorname,
               up_VOL as value
           from t
           order by TradeDate,SecurityID,MinuteStart)
}

// 5. downVOL
def down_VOL_log_1minret(pricedata, n){
    t = select *, log(Close) as log_close from pricedata where Close > 0 order by SecurityID, TradeDate, MinuteStart
    // 计算对数收益率
    update t set ret = log_close - prev(log_close) context by SecurityID, TradeDate
    update t set down_VOL =moving(
        defg(returns){
        mean_return = avg(returns)
        down_rets = min(returns - mean_return, 0)
        return sqrt(sum2(down_rets) / (size(returns) - 1))
    }, ret, n
    ) context by SecurityID, TradeDate
    return (select
               TradeDate,
               SecurityID,
               MinuteStart + 1 AS MinuteStart,
               "down_VOL_log_1minret_" + string(n) + "min" as factorname,
               down_VOL as value
           from t
           order by TradeDate,SecurityID,MinuteStart)
}

//6. 
def ratio_updown_VOL_log_1minret(pricedata, n){
    t = select *, log(Close) as log_close from pricedata where Close > 0 order by SecurityID, TradeDate, MinuteStart
    // 计算对数收益率
    update t set ret = log_close - prev(log_close) context by SecurityID, TradeDate
    update t set up_VOL =moving(
        defg(returns){
        mean_return = avg(returns)
        up_rets = max(returns - mean_return, 0)
        return sqrt(sum2(up_rets) / (size(returns) - 1))
    }, ret, n
    ) context by SecurityID, TradeDate
    update t set down_VOL =moving(
        defg(returns){
        mean_return = avg(returns)
        down_rets = min(returns - mean_return, 0)
        return sqrt(sum2(down_rets) / (size(returns) - 1))
    }, ret, n
    ) context by SecurityID, TradeDate
    return (select
               TradeDate,
               SecurityID,
               MinuteStart + 1 AS MinuteStart,
               "ratio_updown_VOL_log_1minret_" + string(n) + "min" as factorname,
               iif(down_VOL == 0.0, NULL, up_VOL / down_VOL) as value
           from t
           order by TradeDate,SecurityID,MinuteStart)
}

// 7. 
def VOL_ratio_1minhighlow(pricedata, n){
    t = select *, iif(Low>0, High/Low, NULL) as high_low_ratio from pricedata 
    update t set VOL_hl = mstd(high_low_ratio, n) context by SecurityID, TradeDate
    return (select TradeDate, SecurityID, MinuteStart + 1 AS MinuteStart, 
            "VOL_ratio_1minhighlow_" + string(n) + "min" as factorname, 
            VOL_hl as value
            from t 
            order by TradeDate,SecurityID,MinuteStart)
}  

